{
  "name": "@portfolio/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @portfolio/shared build && nest start --watch",
    "build": "pnpm --filter @portfolio/shared build && prisma generate && nest build",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "tsx --test test/auth-flow.spec.ts test/admin-projects.spec.ts",
    "start": "node dist/main.js",
    "db:validate": "prisma validate",
    "db:pull": "prisma db pull",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@portfolio/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.35.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
